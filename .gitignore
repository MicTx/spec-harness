__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

.claude/settings.local.json
.claude/worktrees/

.trae/
.zcode/
.dsh/

# Agent-host local state (memory, runtime); never source assets.
.agents/

# Spec evidence stays local, including frozen history; source contracts stay tracked.
/.spec/specs/
/.spec/docs/
/.spec/plans/
/.spec/archive/
/.spec/autoplan/
/.spec/autorun/
/.spec/artifacts/

dist/
build/
tmp/
*.log

# Local watermark identity and key. Never commit; tests use an in-memory sample.
.watermark-identity.json
.watermark-key
.spec/specs/*/work/
.spec/specs/*/work-*/
.spec/specs/*/state.json
.spec/worktrees/
.spec/charter.md
.spec/lessons.md

# Runtime hot-path caches (process-local memo spill). Never source assets.
.spec/cache/

# Spec-task-package evidence screenshots (ui-review). Too heavy for the repo; keep local only.
.spec/**/*.png
.spec/**/*.jpg
.spec/**/*.jpeg
.spec/**/*.webp
.spec/**/*.gif
.spec/**/*.bmp

# Local marketing builds (sales kits with heavy screenshots); never commit.
marketing/
