#!/bin/sh
set -eu

repo=$(git rev-parse --show-toplevel)
if ! resolved=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || [ "$resolved" != "$repo" ]; then
  printf '%s\n' "Spec Disk Truth: no bound WIP package; check gates not passed. <git-index> unchanged." >&2
  exit 1
fi
checker="__SPEC_CHECK_ALL_SCRIPT_PLACEHOLDER__"
if [ -n "${SPEC_CHECK_ALL_SCRIPT:-}" ]; then
  checker="$SPEC_CHECK_ALL_SCRIPT"
  printf '%s\n' "spec gate: using SPEC_CHECK_ALL_SCRIPT override: $checker" >&2
fi
if [ ! -f "$checker" ]; then
  printf '%s\n' "error: Spec gate checker not found at: $checker" >&2
  exit 1
fi
python="__SPEC_PYTHON_PLACEHOLDER__"
if [ "$python" = "__SPEC_PYTHON_PLACEHOLDER__" ]; then
  python=${SPEC_PYTHON:-$(command -v python3 || true)}
fi
if [ -z "$python" ] || [ "$python" != "${python##*/}" ] && [ ! -x "$python" ]; then
  printf '%s\n' "error: Spec gate requires a trusted Python interpreter" >&2
  exit 1
fi
branch=$(git branch --show-current)
archive_slugs=$(git diff --cached --name-only --diff-filter=ACMRT |
  "$python" -c 'import re, sys; print("\n".join(sorted({m.group(1) for p in sys.stdin.read().splitlines() if (m := re.fullmatch(r"\.spec/specs/archive/([^/]+)/.+", p))})))')
if [ -n "$archive_slugs" ]; then
  "$python" "$checker" --root "$repo" --index --lint-only
  set --
  for slug in $archive_slugs; do set -- "$@" --slug "$slug"; done
  "$python" "$checker" --root "$repo" --index "$@"
  exit $?
fi
if ! git diff --cached --quiet -- .spec; then
  "$python" "$checker" --root "$repo" --index --lint-only
fi
case "$branch" in
  spec/*)
    if "$python" "$checker" --root "$repo" --wip-branch "$branch" >/dev/null; then
      printf '%s\n' "spec gate: WIP commit on integration branch $branch — structural lint only" >&2
      exit 0
    fi
    ;;
esac
if "$python" "$checker" --root "$repo" --index && "$python" "$checker" --root "$repo"; then
  exit 0
fi
printf '%s\n' "Spec Disk Truth: no bound WIP package; check gates not passed. <git-index> unchanged." >&2
exit 1
