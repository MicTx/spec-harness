#!/bin/sh
set -eu

# The source hook fails closed unless rendered; install_git_hooks.py
# replaces these placeholders with absolute paths in installed copies.
repo=$(git rev-parse --show-toplevel)
checker="__SPEC_CHECK_ALL_SCRIPT_PLACEHOLDER__"
# Checker resolution:
#   1. SPEC_CHECK_ALL_SCRIPT environment override — the explicit operator
#      escape hatch; the path in effect is echoed to stderr so a swap is
#      never silent.
#   2. The absolute path rendered by install_git_hooks.py, already held in
#      $checker when the placeholder above was replaced. Repository content
#      can never replace the gate checker; an unrendered template fails
#      closed below.
if [ -n "${SPEC_CHECK_ALL_SCRIPT:-}" ]; then
  checker="$SPEC_CHECK_ALL_SCRIPT"
  printf '%s\n' "spec gate: using SPEC_CHECK_ALL_SCRIPT override: $checker" >&2
fi

if [ ! -f "$checker" ]; then
  printf '%s\n' \
    "error: Spec gate checker not found at: $checker" \
    "  The checker script is expected at the path above." \
    "  Fix:" \
    "    1. Re-run: python3 scripts/install_git_hooks.py --root \"$repo\"" \
    "    2. The checker lives in the spec skill package under scripts/" >&2
  exit 1
fi

python="__SPEC_PYTHON_PLACEHOLDER__"
python_placeholder_prefix=__SPEC_PYTHON_
python_placeholder="${python_placeholder_prefix}PLACEHOLDER__"
if [ "$python" = "$python_placeholder" ]; then
  python=${SPEC_PYTHON:-$(command -v python3 || true)}
fi
if [ -z "$python" ]; then
  printf '%s\n' "error: Spec gate requires a trusted Python interpreter" >&2
  exit 1
fi
if [ "$python" != "${python##*/}" ] && [ ! -x "$python" ]; then
  printf '%s\n' "error: Spec gate requires a trusted Python interpreter" >&2
  exit 1
fi

# Branch-aware gate routing (AUD-07): main commits get the full gate. On a
# spec/* branch an archive commit fully checks its archived packages while
# unrelated active work still gets structural lint; WIP commits get lint only.
# The channel is decided by staged paths, never a committer-declared footer.
baseline=""
for ref in refs/heads/main refs/heads/master; do
  if baseline=$(git rev-parse --verify "$ref" 2>/dev/null); then
    break
  fi
  baseline=""
done
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
case "$branch" in
  spec/*)
    git diff --cached --name-only --diff-filter=ACMRT >/dev/null || exit 1
    archive_slugs=$(git diff --cached --name-only --diff-filter=ACMRT -z |
      "$python" -c '
import re
import sys
slugs = set()
for raw in sys.stdin.buffer.read().split(b"\0"):
    if not raw:
        continue
    parts = raw.decode("utf-8", "surrogateescape").split("/")
    for i in range(len(parts) - 3):
        if parts[i] not in (".spec", ".trae") or parts[i + 1:i + 3] != ["specs", "archive"]:
            continue
        slug = parts[i + 3]
        if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9][a-z0-9_-]*", slug):
            raise SystemExit("spec gate: invalid staged archive slug")
        slugs.add(slug)
print("\n".join(sorted(slugs)))
') || exit 1
    if [ -z "$archive_slugs" ]; then
      printf '%s\n' \
        "spec gate: WIP commit on integration branch $branch — structural lint only;" \
        "the full gate runs for main-branch and archive-carrying commits" >&2
      exec "$python" "$checker" --root "$repo" --lint-only
    fi
    "$python" "$checker" --root "$repo" --lint-only
    "$python" "$checker" --root "$repo" --index --lint-only
    set --
    if [ -n "$baseline" ]; then
      set -- --legacy-baseline "$baseline"
    fi
    for slug in $archive_slugs; do
      set -- "$@" --slug "$slug"
    done
    "$python" "$checker" --root "$repo" "$@"
    exec "$python" "$checker" --root "$repo" --index "$@"
    ;;
esac

set --
if [ -n "$baseline" ]; then
  set -- --legacy-baseline "$baseline"
fi
"$python" "$checker" --root "$repo" "$@"
"$python" "$checker" --root "$repo" --index "$@"
